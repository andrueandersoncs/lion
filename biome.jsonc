{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "README.md",
      "package.json",
      "tsconfig.json",
      "turbo.json",
      "biome.jsonc",
      "docs/**/*.css",
      "docs/**/*.html",
      "docs/**/*.js",
      "packages/*/package.json",
      "packages/*/tsconfig.json",
      "packages/core/**/*.ts",
      "packages/repl/**/*.ts",
      "packages/repl/**/*.tsx",
      // Generated by TanStack Router and shadcn; validated by their upstream tooling.
      "!packages/repl/src/routeTree.gen.ts",
      "!packages/repl/src/components/ui",
      "packages/agent/**/*.ts",
      "packages/agent/**/*.json",
      "packages/examples/**/*.ts",
      "packages/metrics/**/*.ts",
      "packages/site-runtime/**/*.ts",
      // Generated by @lionlang/site-runtime's build.
      "!docs/lion-worker.js",
      "!docs/docs.html",
      // Docs sources: example code inside them must keep its exact whitespace.
      "!packages/site-runtime/content",
      // Generated from @lionlang/core by skills/lion-research/scripts/engine.ts.
      "!skills/lion-research/assets/lion-engine.js",
      "!!.agents",
      "!!.claude",
      "!!.pi"
    ]
  }
}
