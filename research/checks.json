{
  "What do sources disagree on?": [
    "query",
    ["disputed", "?question", "?values"]
  ],
  "What rests on one publisher's word?": [
    "query",
    ["single_origin", "?question", "?value", "?publisher"]
  ],
  "What is known only second-hand?": [
    "query",
    ["secondhand", "?question", "?value", "?credited"]
  ],
  "Which sources are credited with something they do not say?": [
    "query",
    ["misquoted", "?claim", "?to", "?question", "?relayed", "?said"]
  ],
  "Which credited sources are still unread?": [
    "find",
    "?source",
    ["unread", "?source"]
  ],
  "Which assumptions failed, and on what evidence?": [
    "query",
    ["violated", "?assumption", "?witness"]
  ],
  "Which assumptions have no evidence yet?": [
    "query",
    ["unsettled", "?assumption", "?question"]
  ],
  "Which assumptions are confirmed?": ["find", "?a", ["confirmed", "?a"]],
  "Verdicts": [
    "query",
    ["verdict", "?candidate", "?verdict"],
    {
      "order": "candidate"
    }
  ],
  "Ranking of what to adopt": [
    "query",
    [
      "and",
      ["rank", "?candidate", "?position"],
      ["standing", "?candidate", "?gains", "?publishers"]
    ],
    {
      "order": "position"
    }
  ],
  "What each candidate adds": [
    "query",
    ["adds", "?candidate", "?feature", "?technique"]
  ],
  "Candidates with no verdict yet": ["find", "?c", ["unjudged", "?c"]],
  "Which Lion features would one of a candidate's techniques also handle?": [
    "query",
    ["handles", "?candidate", "?feature", "?technique"],
    {
      "order": ["candidate", "feature"]
    }
  ],
  "What would a candidate's techniques bring that Lion lacks?": [
    "query",
    ["brings", "?candidate", "?feature", "?technique"],
    {
      "order": ["candidate", "feature"]
    }
  ],
  "What does a candidate's technique not cover that Lion has?": [
    "query",
    ["limit", "?candidate", "?feature", "?technique", "?claim"]
  ],
  "Which measured Lion gaps does each candidate target?": [
    "query",
    ["gap", "?candidate", "?workload", "?ms"]
  ],
  "What published results back each candidate?": [
    "query",
    ["payoff", "?candidate", "?technique", "?question", "?value"],
    {
      "order": "candidate"
    }
  ],
  "Ranking on net reasons": [
    "query",
    [
      "and",
      ["net_rank", "?candidate", "?position"],
      ["tally", "?candidate", "?reasons", "?against", "?net", "?publishers"]
    ],
    {
      "order": "position"
    }
  ],
  "Blocked": ["query", ["blocks", "?candidate", "?guarantee", "?technique"]],
  "Moot": ["query", ["moot", "?candidate", "?condition"]],
  "Terms the tweet raises, and who defines them": [
    "find",
    {
      "term": "?t",
      "defined by": [
        "aggregate/unique",
        [
          "find",
          "?p",
          [
            "and",
            [
              "answer",
              {
                "defines": "?t"
              },
              true,
              "?c"
            ],
            ["claim", "?c", "?s", "?_", "?_"],
            ["source", "?s", "?_", "?_", "?p", "?_", "?_"]
          ]
        ]
      ]
    },
    [
      "stated",
      {
        "raises": "?t"
      },
      true
    ]
  ],
  "Which statements does no answer rule read?": [
    "find",
    "?claim",
    [
      "and",
      ["claim", "?claim", "?_", "?_", "?_"],
      ["not", ["answer", "?_", "?_", "?claim"]]
    ]
  ],
  "Which technique names do no candidate use?": [
    "aggregate/unique",
    [
      "find",
      "?t",
      [
        "and",
        [
          "answer",
          [
            "schema/open",
            {
              "by": "?t"
            }
          ],
          "?_",
          "?_"
        ],
        ["not", ["uses", "?_", "?t"]]
      ]
    ]
  ],
  "Which features do candidates offer that no claim answers?": [
    "find",
    "?f",
    [
      "and",
      ["offers", "?_", "?f"],
      [
        "not",
        [
          "answer",
          {
            "lion has": "?f"
          },
          "?_",
          "?_"
        ]
      ]
    ]
  ],
  "Caveats": ["query", ["caveat", "?candidate", "?feature", "?technique"]],
  "Where should the next search go?": [
    "query",
    [
      "and",
      ["live", "?lead"],
      ["progress", "?lead", "?read", "?paid_off", "?misses"]
    ],
    {
      "order": ["-paid_off", "read"]
    }
  ],
  "Which leads are done, set aside, or waiting?": [
    "find",
    {
      "lead": "?lead",
      "why": "?why"
    },
    [
      "or",
      [
        "and",
        ["done", "?lead"],
        ["=", "?why", "confirmed by two publishers first-hand"]
      ],
      ["and", ["exhausted", "?lead"], ["=", "?why", "set aside"]]
    ]
  ],
  "Disputed": ["query", ["disputed", "?question", "?values"]],
  "Which figures are not written in the words quoted?": [
    "query",
    ["unquoted", "?claim", "?field", "?value"]
  ],
  "Formal verification: verdicts": [
    "query",
    [
      "and",
      ["weighed_in", "?candidate", "formal-verification"],
      ["verdict", "?candidate", "?verdict"]
    ],
    {
      "order": "candidate"
    }
  ],
  "Formal verification: what each idea builds on": [
    "query",
    ["builds_on", "?candidate", "?builds_on", "?condition"]
  ],
  "Formal verification: what Alchemy gives that Lion lacks": [
    "find",
    "?f",
    ["alchemy_gap", "?f"]
  ],
  "Formal verification: what each idea's techniques need": [
    "query",
    ["fv_needs", "?candidate", "?condition", "?technique"]
  ],
  "Formal verification: caveats": [
    "query",
    ["fv_caveat", "?candidate", "?feature", "?technique"]
  ],
  "Formal verification: when to build each idea": [
    "query",
    ["build_level", "?candidate", "?level"],
    {
      "order": ["level", "candidate"]
    }
  ],
  "Every run: what is left to build, by stage and rank": [
    "query",
    [
      "and",
      ["to_build", "?candidate"],
      ["stage", "?candidate", "?stage"],
      [
        "or",
        ["rank", "?candidate", "?rank"],
        ["and", ["not", ["rank", "?candidate", "?_"]], ["=", "?rank", null]]
      ]
    ],
    {
      "order": ["stage", "rank", "candidate"]
    }
  ],
  "Every run: what each idea left to build waits for": [
    "query",
    [
      "and",
      ["builds_on", "?candidate", "?first", "?condition"],
      ["to_build", "?candidate"],
      ["to_build", "?first"]
    ]
  ],
  "Every run: ideas that would change a documented rule": [
    "query",
    ["overturns", "?candidate", "?rule"]
  ],
  "Every run: ideas passed over, and why": [
    "query",
    ["passed_over", "?candidate", "?reason", "?detail"],
    {
      "order": ["reason", "candidate"]
    }
  ],
  "Every run: ideas the shared rule cannot judge": [
    "query",
    ["unjudged", "?candidate"]
  ],
  "TufaZip: verdicts": [
    "query",
    [
      "and",
      ["weighed_in", "?candidate", "tufazip"],
      ["verdict", "?candidate", "?verdict"]
    ]
  ],
  "TufaZip: beliefs and the evidence": [
    "query",
    [
      "and",
      ["expects", "?belief", "?question", "?expected"],
      ["string/startsWith", "?belief", "tz-"],
      ["answer", "?question", "?value", "?statement"]
    ]
  ],
  "Join gap: every time and growth measured for the triangle workloads": [
    "query",
    [
      "and",
      [
        "or",
        [
          "and",
          ["answer", { "lion measured": "?workload" }, "?value", "?claim"],
          ["=", "?unit", "ms"]
        ],
        [
          "and",
          ["answer", { "lion grows": "?workload" }, "?value", "?claim"],
          ["=", "?unit", "power of n"]
        ]
      ],
      ["string/includes", "?workload", "triangles"]
    ],
    { "order": ["workload", "unit", "claim"] }
  ],
  "Join gap: the hub-graph gap before and now, what the join takes of it, and the joins verdict": [
    "query",
    [
      "and",
      ["gap", "joins", "?workload", "?now_ms"],
      ["answer", { "lion measured": "?workload" }, "?first_ms", "li-l27"],
      [
        "stated",
        {
          "lion measured": [
            "string/concat",
            "?workload",
            ", published CLI v0.12.0"
          ]
        },
        "?v0_12_today_exact_ms"
      ],
      ["=", "?v0_12_today_ms", ["number/round", "?v0_12_today_exact_ms"]],
      [
        "stated",
        {
          "lion measured": "start-up and loading a graph with two hubs, 19,983 edges, no triangles asked"
        },
        "?load_ms"
      ],
      [
        "=",
        "?join_ms",
        ["number/round", ["number/subtract", "?now_ms", "?load_ms"]]
      ],
      [
        "=",
        "?v0_12_today_over_now",
        [
          "number/divide",
          [
            "number/round",
            [
              "number/multiply",
              100,
              ["number/divide", "?v0_12_today_exact_ms", "?now_ms"]
            ]
          ],
          100
        ]
      ],
      ["=", "?closed", ["find", "?w", ["closed", "joins", "?w", "?_", "?_"]]],
      ["=", "?closed_at_or_below_ms", ["number/divide", "?first_ms", 2]],
      ["verdict", "joins", "?verdict"],
      ["rank", "joins", "?rank"],
      ["net_rank", "joins", "?net_rank"],
      ["stage", "joins", "?stage"]
    ]
  ]
}
