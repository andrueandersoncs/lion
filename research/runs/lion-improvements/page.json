              "It would add ",
              ["details", "d", "adds what Lion lacks"],
              ", which Lion lacks. "
            ]
          ],
          ["else", ""]
        ],
        [
          "cond",
          [
            ["reasons_of", "d", "closes a measured gap", "?_"],
            [
              "string/concat",
              "Published speedups of at least 2x apply to work Lion measured as slow: ",
              ["details", "d", "closes a measured gap"],
              ". "
            ]
          ],
          ["else", ""]
        ],
        [
          "cond",
          [
            ["against", "d", "?_"],
            [
              "string/concat",
              "No source shows its techniques covering ",
              ["words/listed", ["find", "?f", ["against", "d", "?f"]]],
              ", which Lion has, so that part is new work. "
            ]
          ],
          [
            "else",
            "No source reports anything Lion has that its techniques cannot cover. "
          ]
        ],
        "The evidence comes from ",
        [
          "words/count",
          [
            "array/head",
            ["find", "?n", ["tally", "d", "?_", "?_", "?_", "?n"]]
          ],
          "independent research group",
          "independent research groups"
        ],
        "."
      ]
    ],
    "third_tie": [
      "array/head",
      ["find", "?others", ["tied", ["at", 3], "?others"]]
    ]
  },
  "summary": [
    "string/concat",
    "The literature gave ",
