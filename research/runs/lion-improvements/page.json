                  ]
                ],
                "; deleting equalities from ",
                [
                  "words/listed",
                  [
                    "find",
                    "?t",
                    [
                      "stated",
                      {
                        "covers": "deletion of equalities",
                        "by": "?t"
                      },
                      true
                    ]
                  ]
                ],
                "; and chases with invented values from ",
                [
                  "words/listed",
                  [
                    "find",
                    "?t",
                    [
                      "stated",
                      {
                        "covers": "existential rules",
                        "by": "?t"
                      },
                      true
                    ]
                  ]
                ],
                ". Congruence closure takes equalities back only in the reverse of the order they came, in ",
                [
                  "words/listed",
                  [
                    "find",
                    "?t",
                    [
                      "stated",
                      {
                        "covers": "lifo retraction of equalities",
                        "by": "?t"
                      },
                      true
                    ]
                  ]
                ],
                "."
              ]
            ]
          ],
          "evidence": [
            "query",
            [
              "and",
              [
                "in",
                "?f",
                [
                  "array/make",
                  "existential rules",
                  "equality rules",
                  "deletion of equalities",
                  "deterministic representatives",
                  "lifo retraction of equalities"
