{
  "title": "What to improve in Lion next",
  "names": {
    "compile": "Compile to direct-style closures",
    "annotate": "Annotated relations (semirings and lattices)",
    "merge": "Merge functions over a union-find (egglog)",
    "incremental": "One algebra of changes (DBSP)",
    "joins": "Worst-case optimal joins",
    "agents": "Programs a model can't get wrong",
