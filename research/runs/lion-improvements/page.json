    {
      "name": "Unknowns and equality",
      "blocks": [
        {
          "type": "answer",
          "question": "Does Lion's answer depend on the order its equality rules are written in?",
          "answer": [
            "cond",
            [
              [
                "disputed",
                {
                  "lion has": "order-independent merges"
                },
                "?_"
              ],
              "Yes, today it can. Lion's README says the result does not depend on the order rules or facts were added in, but one program with its two equality rules swapped names every merged unknown differently. When two values are made one, Lion keeps one of them by a rule that is not transitive, so which one survives depends on which merge came first."
            ],
            [
              [
                "stated",
                {
                  "lion has": "order-independent merges"
                },
                false
              ],
              "Yes: a probe shows answers that change with the order of equality rules."
            ],
            [
              "else",
              "No probe found an answer that depends on the order of equality rules."
            ]
          ],
          "evidence": [
            "query",
            [
              "answer",
              {
                "lion has": "order-independent merges"
              },
              "?independent_of_order",
              "?statement"
            ]
          ]
        },
        {
          "type": "answer",
          "question": "Does keeping each class's least member, by an order that respects nesting, fix it without changing what Lion derives?",
          "answer": [
            "string/concat",
            [
              "cond",
              [
                [
                  "stated",
                  {
                    "covers": "order-independent merges",
                    "by": "least-member classes"
                  },
                  true
                ],
                "It removes the dependence on order: across 10,000 random programs, no reordering of rules or facts changed an answer. "
              ],
              ["else", ""]
            ],
            "Of the random programs Lion accepts, ",
            [
              "words/number",
              [
                "array/head",
                [
                  "find",
                  "?n",
                  [
                    "stated",
                    {
                      "result": "least-member classes",
                      "measure": "random programs Lion accepts that give Lion's exact answer",
                      "bound": "exact",
                      "unit": "count"
                    },
                    "?n"
                  ]
                ]
              ]
            ],
            " gave Lion's exact answer and ",
            [
              "words/number",
              [
                "array/head",
                [
                  "find",
                  "?n",
                  [
                    "stated",
                    {
                      "result": "least-member classes",
                      "measure": "random programs Lion accepts that give Lion's rows with another unknown naming a class",
                      "bound": "exact",
                      "unit": "count"
                    },
                    "?n"
                  ]
                ]
              ]
            ],
            " gave the same rows with the same values shared, where only the unknown that names a class differs. ",
            [
              "cond",
              [
                [
                  "stated",
                  {
                    "covers": "deletion of equalities",
                    "by": "least-member classes"
                  },
                  true
                ],
                "Because a class's representative depends only on what is in the class, a removed equality can be followed by walking the one class it was in; in the test that stayed equal to rebuilding every class from scratch at every step."
              ],
              ["else", ""]
            ]
          ],
          "evidence": [
            "query",
            [
              "answer",
              [
                "schema/open",
                {
                  "by": "least-member classes"
                }
              ],
              "?covers",
              "?statement"
            ]
          ]
        },
        {
          "type": "answer",
          "question": "Has anyone kept invented unknowns and equality up to date together when facts are removed?",
          "answer": [
            "cond",
            [
              ["covers_all", "?_"],
              [
                "string/concat",
                "Yes: ",
                ["words/listed", ["find", "?t", ["covers_all", "?t"]]],
