  "claims": [
    {
      "id": "li-c1",
      "source": "e-zhang-egglog-2023",
      "quote": "Crucially, the map enforces the functional dependency from inputs to outputs.",
      "says": {
        "covers": "keys",
        "by": "egglog",
        "is": true
      }
    },
    {
      "id": "li-c2",
      "source": "e-zhang-egglog-2023",
      "quote": "egglog can simulate Flix programs by setting :merge to the lattice join operator.",
      "says": {
        "covers": "lattice aggregates",
        "by": "egglog",
        "is": true
      }
    },
    {
      "id": "li-c3",
      "source": "e-zhang-egglog-2023",
      "quote": "because the heads of rules can generate fresh ids.",
      "says": {
        "covers": "existential rules",
        "by": "egglog",
        "is": true
      }
    },
    {
      "id": "li-c4",
      "source": "e-zhang-egglog-2023",
      "quote": "egglog ensures that all ids appearing in the database are canonical.",
      "says": {
        "covers": "equality rules",
        "by": "egglog",
        "is": true
      }
    },
    {
      "id": "li-c5",
      "source": "e-zhang-egglog-2023",
      "quote": "egglog eliminates this join modulo equivalence",
      "says": {
        "covers": "joins modulo equality",
        "by": "egglog",
        "is": true
      }
    },
    {
      "id": "li-c6",
      "source": "e-zhang-egglog-2023",
      "quote": "but fail to interact with the rest of the rules efficiently.",
      "says": {
        "covers": "joins modulo equality",
        "by": "souffle eqrel",
        "is": false
      }
    },
    {
      "id": "li-c7",
      "source": "e-zhang-egglog-2023",
      "quote": "the termination condition of egglog is quite open.",
      "says": {
        "covers": "guaranteed termination",
        "by": "egglog",
        "is": false
      }
    },
    {
      "id": "li-c8",
      "source": "e-zhang-egglog-2023",
      "quote": "A future direction is to study proof generations for egglog programs.",
      "says": {
        "covers": "why provenance",
        "by": "egglog",
        "is": false
      }
    },
    {
      "id": "li-c9",
      "source": "e-zhang-egglog-2023",
      "quote": "we do not do this in egglog to be compatible with existing egg applications,",
      "says": {
        "covers": "monotonicity",
        "by": "egglog",
        "is": false
      }
    },
    {
      "id": "li-c10",
      "source": "e-zhang-egglog-2023",
      "quote": "egglog achieves a 4.96 × \\times speedup over patched on average,",
      "says": {
        "result": "egglog",
        "measure": "speedup over Soufflé (fastest sound Steensgaard encoding)",
        "bound": "average",
        "times": 4.96
      }
    },
    {
      "id": "li-c11",
      "source": "e-zhang-egglog-2023",
      "quote": "egglog grows a slightly larger e-graph than egg with a 9.27 × \\times speedup,",
      "says": {
        "result": "egglog",
        "measure": "speedup over egg",
        "bound": "exact",
        "times": 9.27
      }
    },
    {
      "id": "li-c12",
      "source": "e-zhang-egglog-2023",
      "quote": "the relational e-matching technique from Zhang",
      "says": {
        "adopted": "relational e-matching",
        "in": "egglog"
      }
    },
    {
      "id": "li-c13",
      "source": "c-willsey-egg-2021",
      "quote": "Overall, our experiments show an aggregate 88 × 88\\times speedup on congruence",
      "says": {
        "result": "egg rebuilding",
        "measure": "speedup of congruence closure over upward merging",
        "bound": "geometric mean",
        "times": 88
      }
    },
    {
      "id": "li-c14",
      "source": "c-willsey-egg-2021",
      "quote": "The egg backend is over 3000 × 3000\\times faster than Herbie’s initial simplifier and",
      "says": {
        "result": "egg",
        "measure": "speedup over Herbie's initial simplifier",
        "bound": "at least",
        "times": 3000
      }
    },
    {
      "id": "li-c15",
      "source": "c-willsey-egg-2021",
      "quote": "is now used by default as of Herbie 1.4.",
      "says": {
        "adopted": "egg",
        "in": "Herbie"
      }
    },
    {
      "id": "li-c16",
      "source": "c-zhang-relational-ematching-2022",
      "quote": "we apply recent database query execution techniques to guarantee worst-case optimal run time",
      "says": {
        "covers": "worst-case optimal joins",
        "by": "relational e-matching",
        "is": true
      }
    },
    {
      "id": "li-c17",
      "source": "c-nappa-eqrel-2019",
      "quote": "we introduce EQREL, a specialized parallel union-find data structure for scalable equivalence relations, and its integration into a Datalog compiler",
