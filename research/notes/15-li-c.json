      "says": {
        "covers": "equality rules",
        "by": "full tgds",
        "is": true
      }
    },
    {
      "id": "li-c27",
      "source": "c-cali-datalogpm-2010",
      "quote": "Datalog is extended by allowing features such as existential quantifiers, the equality predicate, and the truth constant false to appear in rule heads",
      "says": {
        "covers": "existential rules",
        "by": "datalog±",
        "is": true
      }
    },
    {
      "id": "li-c28",
      "source": "c-cali-datalogpm-2010",
      "quote": "query answering becomes undecidable even when putting together some extremely week forms of TGDs and EGDs such as inclusion dependencies and functional dependencies",
      "says": {
        "covers": "decidable query answering",
        "by": "unrestricted tgds with egds",
        "is": false
      }
    },
    {
      "id": "li-c29",
      "source": "c-cali-datalogpm-2010",
      "quote": "negative constraints can be added to TGDs without any increase of complexity",
      "says": {
        "covers": "invariants",
        "by": "datalog±",
        "is": true
      }
    },
    {
      "id": "li-c30",
      "source": "c-ivliev-nemo-2024",
      "quote": "existential quantifiers in con- clusions are handled with a 1-parallel restricted chase al- gorithm",
      "says": {
