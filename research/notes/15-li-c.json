      }
    },
    {
      "id": "li-c25",
      "source": "c-benedikt-chasebench-2017",
      "quote": "The result of the Skolem chase is unique (if the EGD steps are determinized as in line 8).",
      "says": {
        "covers": "results independent of rule order",
        "by": "skolem chase",
        "is": true
      }
    },
    {
      "id": "li-c26",
      "source": "c-fagin-dataexchange-2005",
