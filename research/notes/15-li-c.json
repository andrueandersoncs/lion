        "by": "souffle eqrel",
        "is": true
      }
    },
    {
      "id": "li-c18",
      "source": "c-nappa-eqrel-2019",
      "quote": "We have implemented the EQREL data structure in the parallel Datalog compiler",
      "says": {
        "adopted": "souffle eqrel",
        "in": "Soufflé"
      }
    },
    {
      "id": "li-c19",
      "source": "c-motik-sameas-2015",
