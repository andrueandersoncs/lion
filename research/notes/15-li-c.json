      }
    },
    {
      "id": "li-c32",
      "source": "c-ivliev-nemo-2024",
      "quote": "The skolem chase, for example, terminates on strictly less rule sets compared to the restricted chase.",
      "says": {
        "covers": "guaranteed termination",
        "by": "skolem chase",
        "is": false
      }
    },
    {
      "id": "li-c33",
      "source": "c-suciu-eqsat-chase-2025",
      "quote": "where EqSat produces an encoded result of the Skolem chase and has the same termination behavior.",
      "says": {
