        "is": true
      }
    },
    {
      "id": "li-c20",
      "source": "c-motik-sameas-2015",
      "quote": "tion time by a factor of up to 31.1 on a single thread",
      "says": {
        "result": "rdfox rewriting",
        "measure": "materialisation speedup over axiomatised equality",
        "bound": "up to",
        "times": 31.1
      }
    },
    {
      "id": "li-c21",
      "source": "c-motik-sameas-2015",
      "quote": "we have implemented our algorithms in the RDFox system",
      "says": {
        "adopted": "rdfox rewriting",
        "in": "RDFox"
      }
    },
    {
      "id": "li-c22",
      "source": "c-benedikt-chasebench-2017",
      "quote": "Dependencies in Σ are weakly acyclic [15] so the restricted chase terminates on all finite instances",
      "says": {
        "covers": "guaranteed termination",
        "by": "weak acyclicity",
        "is": true
      }
    },
    {
      "id": "li-c23",
      "source": "c-benedikt-chasebench-2017",
      "quote": "the unrestricted chase does not necessarily terminate even for weakly acyclic TGDs",
      "says": {
        "covers": "guaranteed termination",
