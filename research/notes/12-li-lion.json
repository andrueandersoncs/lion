        "has": true
      },
      "where": "Graph algorithms"
    },
    {
      "id": "li-l16",
      "source": "lion-readme",
      "quote": "A host function needs nothing to work in rules and queries.",
      "says": {
        "lion": "host functions",
        "has": true
      },
      "where": "Host functions in rules"
    },
    {
      "id": "li-l17",
      "source": "lion-readme",
      "quote": "Adding what the database already holds changes nothing",
