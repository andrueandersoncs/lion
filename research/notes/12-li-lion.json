  "claims": [
    {
      "id": "li-l1",
      "source": "lion-readme",
      "quote": "explains a derived fact by the rule that derived it and what its body rested on",
      "says": {
        "lion": "why provenance",
        "has": true
      },
      "where": "Logic, Forms"
    },
    {
      "id": "li-l2",
      "source": "lion-readme",
      "quote": "A fact that does not hold is explained the other way round.",
      "says": {
        "lion": "showing what is missing for a goal to hold",
        "has": true
      },
      "where": "Logic, Forms"
    },
    {
      "id": "li-l3",
      "source": "lion-readme",
      "quote": "are lattice aggregates: a group's value only moves one way as matches arrive",
      "says": {
        "lion": "lattice aggregates",
        "has": true
      },
      "where": "Recursion through aggregates"
    },
    {
      "id": "li-l4",
      "source": "lion-readme",
      "quote": "A rule head can aggregate.",
      "says": {
        "lion": "aggregates",
        "has": true
      },
      "where": "Aggregates"
    },
    {
      "id": "li-l5",
      "source": "lion-readme",
      "quote": "A keyed relation holds at most one row per key, so a fact whose key is already present replaces the old row, like an upsert.",
      "says": {
        "lion": "keys",
        "has": true
      },
      "where": "Keys"
    },
    {
      "id": "li-l6",
      "source": "lion-readme",
      "quote": "A rule's head can also say that two values are the same",
      "says": {
        "lion": "equality rules",
        "has": true
      },
      "where": "Existential rules"
    },
    {
      "id": "li-l7",
      "source": "lion-readme",
      "quote": "A rule head can say that something exists without saying what it is.",
      "says": {
        "lion": "existential rules",
        "has": true
      },
      "where": "Existential rules"
    },
    {
      "id": "li-l8",
      "source": "lion-readme",
      "quote": "A rule cannot ask a question about a relation that depends on its own head, so every program has a single well-defined answer. Negation is one such question.",
      "says": {
        "lion": "stratified negation",
        "has": true
      },
      "where": "Guarantees"
    },
    {
      "id": "li-l9",
      "source": "lion-readme",
      "quote": "A rule cannot ask a question about a relation that depends on its own head, so every program has a single well-defined answer. Negation is one such question.",
      "says": {
        "lion": "non-stratified negation",
        "has": false
      },
      "where": "Guarantees"
    },
    {
      "id": "li-l10",
      "source": "lion-readme",
      "quote": "Answers are computed bottom-up with semi-naive evaluation",
      "says": {
        "lion": "recursion",
        "has": true
      },
      "where": "Guarantees"
    },
    {
      "id": "li-l11",
      "source": "lion-readme",
      "quote": "Lion rewrites the rules with the magic-sets technique",
      "says": {
        "lion": "goal-directed evaluation",
        "has": true
      },
      "where": "Goal-directed queries"
    },
    {
      "id": "li-l12",
      "source": "lion-readme",
      "quote": "A change to facts is followed through what was derived, so it costs what it reaches and not what the database holds.",
      "says": {
        "lion": "derived rows kept up to date as facts change",
        "has": true
      },
      "where": "Guarantees"
    },
    {
      "id": "li-l13",
      "source": "lion-readme",
      "quote": "Three kinds of relation cannot be followed row by row",
      "says": {
        "lion": "incremental maintenance of every relation",
        "has": false
      },
      "where": "Guarantees"
    },
    {
      "id": "li-l14",
      "source": "lion-readme",
      "quote": "An invariant is a query assertion the database keeps.",
      "says": {
        "lion": "invariants",
        "has": true
      },
      "where": "Invariants"
    },
    {
      "id": "li-l15",
      "source": "lion-readme",
