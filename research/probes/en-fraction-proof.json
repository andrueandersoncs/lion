          ["number/lessThan", "?x", 1],
          [
            "not",
            [
              "number/equals?",
              ["number/subtract", ["number/add", "?x", 0.2], 0.2],
              "?x"
            ]
          ]
        ]
      ]
    ]
  ],
  "plain code: 0.1 with 0.2 added and taken away": [
    "number/subtract",
    ["number/add", 0.1, 0.2],
    0.2
  ],
  "plain code: that equals 0.1": [
    "number/equals?",
    ["number/subtract", ["number/add", 0.1, 0.2], 0.2],
    0.1
  ]
}
