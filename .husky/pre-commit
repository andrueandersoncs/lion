# The tests. A commit on an agent's branch (claude/*) runs the tests and
# checks the change can reach, picked by `bun run affected` from the reach
# map, after building what they read; every other commit, one with no reach
# map, and one made with LION_FULL_TESTS=1 runs every test. The full suite
# runs before a merge, and CI runs it on every pull request and push to main.
branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  claude/*)
    if [ -z "$LION_FULL_TESTS" ] && [ -f out/reach/map.json ]; then
      bunx turbo build || exit 1
      bun run affected --run || exit 1
    else
      bun run test || exit 1
    fi
    ;;
  *)
    bun run test || exit 1
    ;;
esac

# ultracite
#!/bin/sh
# Exit on any error
set -e

# Check if there are any staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

# Run formatter
bun x ultracite fix
FORMAT_EXIT_CODE=$?

# Re-stage files that were already staged
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Ultracite found issues that could not be auto-fixed."
  exit $FORMAT_EXIT_CODE
fi

echo "✨ Files formatted by Ultracite"
