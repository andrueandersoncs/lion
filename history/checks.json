{
  "fail": {
    "Feature and fix commits that no claim is made by": [
      "query",
      ["unaccounted", "?commit", "?subject"],
      {
        "order": "commit"
      }
    ],
    "Commits named that no commit starts with": [
      "query",
      ["unresolved", "?claim", "?commit"],
      {
        "order": "claim"
      }
    ],
    "Commits named that more than one commit starts with": [
      "query",
      ["ambiguous_ref", "?claim", "?commit", "?count"],
      {
        "order": "claim"
      }
    ],
    "Quotes that are not in the commit message they cite": [
      "query",
      ["misquoted_ref", "?claim", "?commit", "?quote"],
      {
        "order": "claim"
      }
    ],
    "Decisions followed that no record holds": [
      "query",
      ["unknown_decision", "?claim", "?decision"],
      {
        "order": "claim"
      }
    ],
    "Decision records with no decision claim": [
      "query",
      ["undecided_record", "?record"],
      {
        "order": "record"
      }
    ],
    "Releases at the same commit": [
      "query",
      ["shared_commit", "?release", "?other", "?commit"],
      {
        "order": "release"
      }
    ],
    "Versions released twice": [
      "query",
      ["repeated_version", "?name", "?version", "?release", "?other"],
      {
        "order": "release"
      }
    ],
    "Versions that do not rise from one release to the next": [
      "query",
      ["regressed", "?name", "?earlier", "?later"],
      {
        "order": "name"
      }
    ],
    "Tags that point at another commit than their release": [
      "query",
      ["mistagged", "?release", "?tag", "?commit"],
      {
        "order": "release"
      }
    ]
  },
  "note": {
    "Releases with no tag yet": [
      "query",
      ["untagged", "?release", "?tag"],
      {
        "order": "tag"
      }
    ]
  },
  "holds": {
    "claims": [
      "aggregate/countUnique",
      [
        "find",
        "?c",
        ["and", ["claim", "?c", "?_", "?_", "?_"], ["made_by", "?c", "?_"]]
      ]
    ],
    "decided questions": [
      "aggregate/countUnique",
      [
        "find",
        "?t",
        [
          "answer",
          {
            "decision": "?t"
          },
          "?_",
          "?_"
        ]
      ]
    ],
    "decision records": [
      "aggregate/count",
      ["find", "?id", ["record", "?id", "?_", "?_"]]
    ],
    "items waiting for a release": [
      "aggregate/count",
      ["find", ["array/make", "?q", "?v"], ["waiting", "?q", "?v"]]
    ],
    "releases": [
      "aggregate/count",
      ["find", "?r", ["and", ["release", "?r", "?_"], ["not", ["draft", "?r"]]]]
    ],
    "commits": [
      "aggregate/count",
      [
        "find",
        "?h",
        ["and", ["subject", "?h", "?_"], ["not", ["=", "?h", "working tree"]]]
      ]
    ]
  }
}
