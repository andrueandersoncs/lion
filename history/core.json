[
  "begin",

  [
    "define",
    "nonEmpty?",
    ["lambda", ["t"], ["number/greaterThan", ["string/length", "t"], 0]]
  ],
  [
    "define",
    "madeOf?",
    [
      "lambda",
      ["letters"],
      [
        "lambda",
        ["t"],
        [
          "array/reduce",
          ["string/split", "t", ""],
          true,
          [
            "lambda",
            ["ok", "letter"],
            ["boolean/and", "ok", ["string/includes", "letters", "letter"]]
          ]
        ]
      ]
    ]
  ],
  [
    "define",
    "words",
    [
      "lambda",
      ["t"],
      [
        "string/join",
        [
          "array/flat-map",
          [
            "string/split",
            ["string/join", ["string/split", "t", "\n"], " "],
            " "
          ],
          [
            "lambda",
            ["word"],
            [
              "cond",
              [["string/equals?", "word", ""], ["array/make"]],
              ["else", ["array/make", "word"]]
            ]
          ]
        ],
        " "
      ]
    ]
  ],
  [
    "define",
    "versionRank",
    [
      "lambda",
      ["v"],
      [
        "array/reduce",
        ["string/split", "v", "."],
        0,
        [
          "lambda",
          ["rank", "part"],
          [
            "number/add",
            ["number/multiply", "rank", 1000],
            ["number/fromString", "part"]
          ]
        ]
      ]
    ]
  ],

  [
    "schema",
    "Text",
    ["schema/allOf", "value/string?", "nonEmpty?"],
    "Id",
    [
      "schema/allOf",
      "value/string?",
      "nonEmpty?",
      ["madeOf?", "abcdefghijklmnopqrstuvwxyz0123456789-"]
    ],
    "Hash",
    [
      "schema/allOf",
      "value/string?",
      [
        "lambda",
        ["h"],
        ["number/greaterThanOrEqualTo", ["string/length", "h"], 7]
      ],
      [
        "lambda",
        ["h"],
        ["number/lessThanOrEqualTo", ["string/length", "h"], 40]
      ],
      ["madeOf?", "0123456789abcdef"]
    ],
    "Version",
    [
      "schema/allOf",
      "value/string?",
      [
        "lambda",
        ["v"],
        [
          "boolean/and",
          ["number/equals?", ["array/length", ["string/split", "v", "."]], 3],
          [
            "array/reduce",
            ["string/split", "v", "."],
            true,
            [
              "lambda",
              ["ok", "part"],
              [
                "boolean/and",
                "ok",
                ["value/integer?", ["number/fromString", "part"]]
              ]
            ]
          ]
        ]
      ]
    ],
    "References",
    [
      "schema/arrayOf",
      ["schema/anyOf", "Hash", { "commit": "Hash", "quote": "Text" }]
    ],
    "Decision",
    {
      "id": "Id",
      "title": "Text",
      "context": "Text",
      "decision": "Text",
      "consequences": "Text",
      "alternatives": [
        "schema/optional",
        ["schema/arrayOf", { "option": "Text", "rejected": "Text" }]
      ],
      "supersedes": ["schema/optional", ["schema/arrayOf", "Id"]],
      "commits": ["schema/optional", "References"],
      "claims": [
        "schema/optional",
        ["schema/arrayOf", { "quote": "Text", "says": "value/any?" }]
      ]
    },
    "Change",
    {
      "kind": "Text",
      "text": "Text",
      "decisions": ["schema/optional", ["schema/arrayOf", "Id"]],
      "commits": ["schema/optional", "References"]
    },
    "Internal",
    { "internal": "Text", "commits": "References" },
    "Release",
    {
      "ships": [
        "schema/allOf",
        [
          "schema/arrayOf",
          [
            "schema/anyOf",
            { "name": "Text", "version": "Version" },
            { "name": "Text" }
          ]
        ],
        ["lambda", ["s"], ["number/greaterThan", ["array/length", "s"], 0]]
      ],
      "summary": ["schema/optional", "Text"],
      "notes": [
        "schema/optional",
        ["schema/arrayOf", { "kind": "Text", "text": "Text" }]
      ],
      "commit": ["schema/optional", "Hash"],
      "draft": ["schema/optional", true]
    },
    "DecisionFile",
    { "path": "Text", "data": "Decision" },
    "ChangesFile",
    {
      "path": "Text",
      "data": ["schema/arrayOf", ["schema/anyOf", "Change", "Internal"]]
    },
    "ReleaseFile",
    { "path": "Text", "data": "Release" }
  ],

  [
