{
  "id": "hoare-loop-invariant",
  "pillar": "proofs",
  "statement": "A state is a record {\"i\", \"s\", \"n\"} of whole numbers. The loop runs while i < n, and each iteration adds 1 to i and 2 to s. Define a function of a predicate inv on states that gives true when inv is inductive: every state that meets inv and has i < n is taken by one iteration to a state that meets inv, for every state; and false otherwise. The program's value is the function.",
  "inputs": {},
  "check": [
    "lambda",
    ["inductive"],
    [
      "and",
      [
        "inductive",
        [
          "lambda",
          ["st"],
          [
            "number/equals?",
            ["object/get", "st", "s"],
            ["number/multiply", 2, ["object/get", "st", "i"]]
          ]
        ]
      ],
      [
        "inductive",
        [
          "lambda",
          ["st"],
          [
            "number/lessThanOrEqualTo",
            ["object/get", "st", "i"],
            ["object/get", "st", "n"]
          ]
        ]
      ],
      [
        "not",
        [
          "inductive",
          [
            "lambda",
            ["st"],
            [
              "number/equals?",
              ["object/get", "st", "s"],
              ["object/get", "st", "i"]
            ]
          ]
        ]
      ],
      [
        "not",
        [
          "inductive",
          [
            "lambda",
            ["st"],
            [
              "number/lessThanOrEqualTo",
              ["object/get", "st", "s"],
              ["number/multiply", 2, ["object/get", "st", "n"]]
            ]
          ]
        ]
      ]
    ]
  ],
  "tags": ["solver", "schemas", "induction-step"],
  "origin": "Floyd-Hoare loop invariants: the inductive step of a loop's proof"
}
