      ["d1", "month", "March"],
      ["d3", "author", "Stephan"],
      ["d5", "year", 2001],
      ["d1", "author", "Ramakrishnan"],
      ["d3", "title", "Push Method"],
      ["d4", "month", "May"],
      ["d1", "author", "Beeri"],
      ["d1", "title", "On the Power of Magic"],
      ["d3", "year", 2017],
      ["d3", "month", "June"],
      ["d4", "author", "Brass"],
      ["d1", "year", 1987],
      ["d3", "author", "Brass"],
      ["d2", "year", 1986],
      ["d2", "title", "Magic Sets"],
      ["d5", "title", "Untitled Draft"],
      ["d2", "author", "Bancilhon"],
      ["d4", "year", 2000],
      ["d5", "month", "July"],
      ["d4", "title", "SLDMagic"]
    ]
  },
  "check": [
    "lambda",
    ["rows"],
    [
